**/*.py[cod]
**/.pytest_cache/
**/.env*
**/*.pem
**/*.key
**/*.pt
**/*.pth
**/*.ckpt
**/*.pkl
**/*.safetensors
**/node_modules/
**/.venv/
**/WORKING/
**/PRIVATE_RECORDS/
**/web_cache/
**/cache/
**/.cache/
**/wandb/
**/runs/
**/rendered*/
/article/
